# Repository-level ignore: fish runtime/user-specific files
# Ignore fish history and universal variables (user-specific)
.config/fish/fish_history
.config/fish/fish_variables*
.config/fish/functions/
.config/fish/completions/
.config/fish/conf.d/


# Runtime / temp files created by fish
.config/fish/fishd.*
.config/fish/*.tmp*

# Editor backups / swap
.config/fish/*~
.config/fish/*.swp

# If you want to ignore everything in the fish dir except tracked configs,
# consider uncommenting the next line and adding explicit allow-lists.
# .config/fish/
.config/waybar/libniri_taskbar-focused.so
tools/

# Python bytecode
**/__pycache__/
*.py[cod]

# Waybar nightlight temporary state files
.config/waybar/nightlight-temp
.config/waybar/nightlight-state

# NOTE: .config/themes/global-colors.css is regenerated by
# ~/.local/bin/theme-from-wallpaper on every wallpaper change. It stays tracked
# because waybar/style.css @imports it and a fresh clone needs it to exist.
# Expect it to show as modified often; global-colors.static.css is the seed.

# systemd enablement symlinks (absolute paths; recreated by `systemctl --user enable`)
.config/systemd/user/*.target.wants/
