#!/usr/bin/env python3
"""Fetch a safe, desktop-shaped wallpaper from Konachan and set it via awww.

Resolved path is mirrored to the QuickShell state file that the Termux SSH
helper reads remotely, so keep that path exact.
"""

import json
import os
import random
import subprocess
import sys
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path.home()
DEST_DIR = HOME / ".local/share/wallpapers/konachan"
STATE_FILE = HOME / ".local/state/quickshell/user/generated/wallpaper/path.txt"
LEGACY_CACHE = HOME / ".cache/wallpaper"
KEEP_LAST = 30

API = "https://konachan.net/post.json"
UA = "konachan-wallpaper/1.0 (personal desktop rotator)"

# Dark / violet / neko / digicore leaning. Konachan (Moebooru) caps anonymous
# queries at two tags, so we spend one on rating:safe and rotate the other.
TAG_POOL = [
    "purple_hair", "purple_eyes", "animal_ears", "nekomimi", "catgirl",
    "night", "stars", "neon", "cyberpunk", "dark", "moon", "city",
    "gradient", "glitch", "tail", "long_hair",
]

MIN_W, MIN_H = 1920, 1080
MIN_AR, MAX_AR = 1.30, 2.40  # landscape / desktop-ish only
OK_EXT = {".jpg", ".jpeg", ".png"}


def log(msg):
    print(f"konachan-wallpaper: {msg}", file=sys.stderr)


def fetch(tag):
    params = urllib.parse.urlencode(
        {"limit": 100, "tags": f"rating:safe {tag}"}
    )
    req = urllib.request.Request(f"{API}?{params}", headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)


def usable(post):
    if post.get("rating") != "s":
        return False
    url = post.get("file_url") or ""
    if Path(urllib.parse.urlparse(url).path).suffix.lower() not in OK_EXT:
        return False
    w, h = post.get("width") or 0, post.get("height") or 0
    if w < MIN_W or h < MIN_H:
        return False
    return MIN_AR <= (w / h) <= MAX_AR


def pick():
    for tag in random.sample(TAG_POOL, len(TAG_POOL)):
        try:
            posts = fetch(tag)
        except Exception as exc:
            log(f"query failed for {tag!r}: {exc}")
            continue
        good = [p for p in posts if usable(p)]
        if good:
            log(f"tag {tag!r}: {len(good)}/{len(posts)} usable")
            return random.choice(good)
        log(f"tag {tag!r}: no usable posts")
    return None


def download(post):
    url = post["file_url"]
    name = f"konachan-{post['id']}{Path(urllib.parse.urlparse(url).path).suffix.lower()}"
    dest = DEST_DIR / name
    if dest.exists() and dest.stat().st_size > 0:
        return dest
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    tmp = dest.with_suffix(dest.suffix + ".part")
    with urllib.request.urlopen(req, timeout=120) as resp, open(tmp, "wb") as out:
        while chunk := resp.read(65536):
            out.write(chunk)
    tmp.replace(dest)
    return dest


def set_wallpaper(path):
    """Display the image.

    niri uses awww. end-4's Hyprland rice has no wallpaper daemon at all --
    its QuickShell reads the generated path.txt directly -- so there the
    write of path.txt in main() *is* the wallpaper change, and awww is
    skipped rather than started.
    """
    if subprocess.run(["pgrep", "-x", "awww-daemon"],
                      stdout=subprocess.DEVNULL).returncode != 0:
        log("awww-daemon not running; relying on path.txt (quickshell rice)")
        return
    subprocess.run(
        ["awww", "img", "--filter", "Lanczos3", "--resize", "crop",
         "--transition-duration", "1", "--transition-type", "center", str(path)],
        check=False,
    )


def prune():
    files = sorted(
        (p for p in DEST_DIR.iterdir() if p.suffix.lower() in OK_EXT),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    for stale in files[KEEP_LAST:]:
        stale.unlink(missing_ok=True)


def main():
    DEST_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)

    post = pick()
    if post is None:
        log("no usable post found across all tags")
        return 1

    path = download(post)
    set_wallpaper(path)

    STATE_FILE.write_text(f"{path}\n")
    LEGACY_CACHE.write_text(str(path))

    # Retheme the bar from the new wallpaper; never fatal.
    subprocess.run([str(Path.home() / ".local/bin/theme-from-wallpaper"), str(path)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    prune()
    log(f"set {path} (post {post['id']}, {post['width']}x{post['height']})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
